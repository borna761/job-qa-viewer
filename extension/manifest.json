{
  "manifest_version": 3,
  "name": "Job Tracker",
  "version": "1.4",
  "minimum_chrome_version": "99",
  "description": "Shows whether you've already applied to a job posting",
  "permissions": ["tabs", "alarms", "storage", "scripting", "activeTab"],
  "host_permissions": ["http://localhost:3456/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Job Tracker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
